{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "화학물질 수입량 집계 시스템",
  "version": "0.1.0",
  "identifier": "com.koreabranch.chemtracker",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "화학물질 수입량 집계 시스템 — 코리아 지사",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "additionalBrowserArgs": "--js-flags=--max-old-space-size=128"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
